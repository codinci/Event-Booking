################################################################################
# APPLICATION CONFIGURATION
################################################################################

# Application name displayed in emails and UI
APP_NAME="Event Booking"

# Environment: local, staging, production
APP_ENV=local

# Base URL of your application
APP_URL=http://localhost:8000

# Enable debug mode (set to false in production!)
APP_DEBUG=true

# Application encryption key (auto-generated by: php artisan key:generate)
APP_KEY=

# Application locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance driver
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Number of PHP CLI workers (improves performance)
# PHP_CLI_SERVER_WORKERS=4

################################################################################
# SECURITY & HASHING
################################################################################

# Number of bcrypt rounds for password hashing (higher = more secure but slower)
BCRYPT_ROUNDS=12

################################################################################
# LOGGING
################################################################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################################################################
# DATABASE CONFIGURATION
################################################################################

# SQLite (default for local development)
DB_CONNECTION=sqlite

# MySQL Configuration (uncomment for production or Docker)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=event_booking
# DB_USERNAME=root
# DB_PASSWORD=your_secure_password
# DB_ROOT_PASSWORD=your_root_password

################################################################################
# SESSION CONFIGURATION
################################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

################################################################################
# CACHE & QUEUE CONFIGURATION
################################################################################

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue driver: sync, redis, database
# Use 'redis' for async job processing with Docker
QUEUE_CONNECTION=redis

# Cache store: array, file, redis, memcached
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

################################################################################
# REDIS CONFIGURATION
################################################################################

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

################################################################################
# MAIL CONFIGURATION
################################################################################

# Mail driver: log, smtp, mailgun, sendgrid, ses, resend, postmark
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Email address used in "From" field for all outgoing emails
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

################################################################################
# M-PESA / DARAJA PAYMENT GATEWAY CONFIGURATION
################################################################################

# Daraja API Credentials - Required for M-PESA payments
# Get these from: https://developer.safaricom.co.ke/

# Your organization's shortcode (Business short code or Till number)
# Example: 174379 (for sandbox) or your production shortcode
DARAJA_BUSINESS_SHORT_CODE=

# Consumer key from Daraja app credentials
DARAJA_CONSUMER_KEY=

# Consumer secret from Daraja app credentials
DARAJA_CONSUMER_SECRET=

# Initiator password for B2C (refund) transactions
DARAJA_INITIATOR_PASSWORD=

# Callback URL for payment confirmations (must be publicly accessible HTTPS in production)
# This URL receives M-PESA payment callback notifications
# In production, set to your public domain: https://yourdomain.com/payments/daraja/callback
DARAJA_CALLBACK_URL=

# Test phone number for Daraja testing (format: 254XXXXXXXXX)
VITE_DARAJA_TEST_PHONE=

# Daraja environment: sandbox or production
# DARAJA_ENVIRONMENT=sandbox

################################################################################
# AWS / STORAGE CONFIGURATION
################################################################################

# AWS credentials for S3 storage (optional, only if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

################################################################################
# FRONTEND CONFIGURATION
################################################################################

# App name displayed in Vite frontend
VITE_APP_NAME="${APP_NAME}"
